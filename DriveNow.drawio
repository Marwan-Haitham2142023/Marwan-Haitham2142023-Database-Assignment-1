        <mxCell id="v202" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="A VIOLATION is stored once it is matched to a rental (RentalNo NN). FEEDBACK is weak 1:1 with RENTAL (PK = RentalNo), rating 1-5." vertex="1">
          <mxGeometry height="30" width="1230" x="220" y="2264" as="geometry" />
        </mxCell>
        <mxCell id="v203" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="A33" vertex="1">
          <mxGeometry height="30" width="60" x="50" y="2294" as="geometry" />
        </mxCell>
        <mxCell id="v204" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="7.15" vertex="1">
          <mxGeometry height="30" width="110" x="110" y="2294" as="geometry" />
        </mxCell>
        <mxCell id="v205" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="JOB_CARD.TotalCost is stored (default 0). Mechanics are M:N with HoursSpent; JOB_PART stores the unit cost at the time. Damage link: (DamageRentalNo, DamageReportNo) NULL UQ." vertex="1">
          <mxGeometry height="30" width="1230" x="220" y="2294" as="geometry" />
        </mxCell>
        <mxCell id="v206" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="A34" vertex="1">
          <mxGeometry height="30" width="60" x="50" y="2324" as="geometry" />
        </mxCell>
        <mxCell id="v207" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="7.15" vertex="1">
          <mxGeometry height="30" width="110" x="110" y="2324" as="geometry" />
        </mxCell>
        <mxCell id="v208" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="PART_SUPPLIER keeps the current supplier price and lead time per part (a fixed price list, no history)." vertex="1">
          <mxGeometry height="30" width="1230" x="220" y="2324" as="geometry" />
        </mxCell>
        <mxCell id="v209" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="A35" vertex="1">
          <mxGeometry height="30" width="60" x="50" y="2354" as="geometry" />
        </mxCell>
        <mxCell id="v210" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="7.16" vertex="1">
          <mxGeometry height="30" width="110" x="110" y="2354" as="geometry" />
        </mxCell>
        <mxCell id="v211" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="Payment types: Deposit | Final | Damage | LateFee | Fine | Invoice. Methods: Cash | Card | BankTransfer. TransactionRef is NULL for cash and UNIQUE otherwise. Amount &gt; 0." vertex="1">
          <mxGeometry height="30" width="1230" x="220" y="2354" as="geometry" />
        </mxCell>
        <mxCell id="v212" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="A36" vertex="1">
          <mxGeometry height="30" width="60" x="50" y="2384" as="geometry" />
        </mxCell>
        <mxCell id="v213" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="7.16" vertex="1">
          <mxGeometry height="30" width="110" x="110" y="2384" as="geometry" />
        </mxCell>
        <mxCell id="v214" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="Corporate monthly invoice: INVOICE UQ(CustomerNo, InvoiceMonth); rentals point to it; a payment of an invoice has InvoiceNo and no RentalNo (exactly one of the two)." vertex="1">
          <mxGeometry height="30" width="1230" x="220" y="2384" as="geometry" />
        </mxCell>
        <mxCell id="v215" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="A37" vertex="1">
          <mxGeometry height="30" width="60" x="50" y="2414" as="geometry" />
        </mxCell>
        <mxCell id="v216" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="10, 11" vertex="1">
          <mxGeometry height="30" width="110" x="110" y="2414" as="geometry" />
        </mxCell>
        <mxCell id="v217" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="Money is EGP (no currency column). Payroll, GPS dashboard and payment gateway are out of scope. Columns ending in DT are date-time; data types are not drawn." vertex="1">
          <mxGeometry height="30" width="1230" x="220" y="2414" as="geometry" />
        </mxCell>
        <mxCell id="v218" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#8e44ad;" value="&lt;b&gt;3. Contradictions (parts of the SRS that disagree)&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="900" x="50" y="2484" as="geometry" />
        </mxCell>
        <mxCell id="v219" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#8e44ad;fontColor=#ffffff;fontStyle=1;strokeColor=#ffffff;fontSize=12;" value="#" vertex="1">
          <mxGeometry height="30" width="60" x="50" y="2520" as="geometry" />
        </mxCell>
        <mxCell id="v220" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#8e44ad;fontColor=#ffffff;fontStyle=1;strokeColor=#ffffff;fontSize=12;" value="Section A says" vertex="1">
          <mxGeometry height="30" width="400" x="110" y="2520" as="geometry" />
        </mxCell>
        <mxCell id="v221" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#8e44ad;fontColor=#ffffff;fontStyle=1;strokeColor=#ffffff;fontSize=12;" value="Section B says" vertex="1">
          <mxGeometry height="30" width="400" x="510" y="2520" as="geometry" />
        </mxCell>
        <mxCell id="v222" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#8e44ad;fontColor=#ffffff;fontStyle=1;strokeColor=#ffffff;fontSize=12;" value="How the design handles it" vertex="1">
          <mxGeometry height="30" width="540" x="910" y="2520" as="geometry" />
        </mxCell>
        <mxCell id="v223" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="C1" vertex="1">
          <mxGeometry height="46" width="60" x="50" y="2550" as="geometry" />
        </mxCell>
        <mxCell id="v224" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="7.1: &quot;A manager runs only one branch at a time.&quot;" vertex="1">
          <mxGeometry height="46" width="400" x="110" y="2550" as="geometry" />
        </mxCell>
        <mxCell id="v225" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="7.1: &quot;If a manager resigns, the regional director temporarily takes their place.&quot;" vertex="1">
          <mxGeometry height="46" width="400" x="510" y="2550" as="geometry" />
        </mxCell>
        <mxCell id="v226" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="A director covering several vacant branches would manage more than one branch. Design keeps UQ(ManagerID); the director case is raised as Q1." vertex="1">
          <mxGeometry height="46" width="540" x="910" y="2550" as="geometry" />
        </mxCell>
        <mxCell id="v227" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="C2" vertex="1">
          <mxGeometry height="46" width="60" x="50" y="2596" as="geometry" />
        </mxCell>
        <mxCell id="v228" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="7.1: &quot;Airport branches are an exception: SOME of them work around the clock.&quot;" vertex="1">
          <mxGeometry height="46" width="400" x="110" y="2596" as="geometry" />
        </mxCell>
        <mxCell id="v229" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="9, NFR-2: &quot;airport branches need 24/7 access&quot; (all of them)." vertex="1">
          <mxGeometry height="46" width="400" x="510" y="2596" as="geometry" />
        </mxCell>
        <mxCell id="v230" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="Is24Hours is stored per branch; NFR-2 is read as system availability, not as branch working hours." vertex="1">
          <mxGeometry height="46" width="540" x="910" y="2596" as="geometry" />
        </mxCell>
        <mxCell id="v231" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="C3" vertex="1">
          <mxGeometry height="46" width="60" x="50" y="2642" as="geometry" />
        </mxCell>
        <mxCell id="v232" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="7.3: &quot;Pricing is set per category&quot; and customers book a category." vertex="1">
          <mxGeometry height="46" width="400" x="110" y="2642" as="geometry" />
        </mxCell>
        <mxCell id="v233" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="7.3 COO note: &quot;some luxury cars ... have their own price.&quot;" vertex="1">
          <mxGeometry height="46" width="400" x="510" y="2642" as="geometry" />
        </mxCell>
        <mxCell id="v234" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="Price level is category in one place and model/vehicle in the other. Handled with MODEL_RATE overriding the category rate (A11, Q9)." vertex="1">
          <mxGeometry height="46" width="540" x="910" y="2642" as="geometry" />
        </mxCell>
        <mxCell id="v235" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="C4" vertex="1">
          <mxGeometry height="46" width="60" x="50" y="2688" as="geometry" />
        </mxCell>
        <mxCell id="v236" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="7.3 / 8 (Finance): which price applied on any day in history must be provable for categories, insurance and extras." vertex="1">
          <mxGeometry height="46" width="400" x="110" y="2688" as="geometry" />
        </mxCell>
        <mxCell id="v237" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="7.4 and 7.13: only the price charged on each rental must be stored." vertex="1">
          <mxGeometry height="46" width="400" x="510" y="2688" as="geometry" />
        </mxCell>
        <mxCell id="v238" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="Only categories get a rate history table; insurance and extras are covered by the price copied on the rental (Q13)." vertex="1">
          <mxGeometry height="46" width="540" x="910" y="2688" as="geometry" />
        </mxCell>
        <mxCell id="v239" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="C5" vertex="1">
          <mxGeometry height="46" width="60" x="50" y="2734" as="geometry" />
        </mxCell>
        <mxCell id="v240" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="7.16: &quot;A rental may have several payments&quot; (payments belong to rentals)." vertex="1">
          <mxGeometry height="46" width="400" x="110" y="2734" as="geometry" />
        </mxCell>
        <mxCell id="v241" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="7.16 Finance note: corporate clients are invoiced monthly and do not pay per rental." vertex="1">
          <mxGeometry height="46" width="400" x="510" y="2734" as="geometry" />
        </mxCell>
        <mxCell id="v242" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="PAYMENT may reference a RENTAL or an INVOICE (exactly one)." vertex="1">
          <mxGeometry height="46" width="540" x="910" y="2734" as="geometry" />
        </mxCell>
        <mxCell id="v243" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="C6" vertex="1">
          <mxGeometry height="46" width="60" x="50" y="2780" as="geometry" />
        </mxCell>
        <mxCell id="v244" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="7.12: &quot;two employees must be recorded on every rental&quot; (hand-over agent and receiving agent)." vertex="1">
          <mxGeometry height="46" width="400" x="110" y="2780" as="geometry" />
        </mxCell>
        <mxCell id="v245" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="7.12: the receiving agent &quot;is obviously not known until the car is returned&quot;." vertex="1">
          <mxGeometry height="46" width="400" x="510" y="2780" as="geometry" />
        </mxCell>
        <mxCell id="v246" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="HandoverAgentID is NN; ReceivedAgentID is NULL until return." vertex="1">
          <mxGeometry height="46" width="540" x="910" y="2780" as="geometry" />
        </mxCell>
        <mxCell id="v247" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="C7" vertex="1">
          <mxGeometry height="46" width="60" x="50" y="2826" as="geometry" />
        </mxCell>
        <mxCell id="v248" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="7.11: a reservation is marked No-Show &quot;if the customer never arrives&quot;." vertex="1">
          <mxGeometry height="46" width="400" x="110" y="2826" as="geometry" />
        </mxCell>
        <mxCell id="v249" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="12 Glossary: No-Show is &quot;a CONFIRMED reservation where the customer never arrived&quot;." vertex="1">
          <mxGeometry height="46" width="400" x="510" y="2826" as="geometry" />
        </mxCell>
        <mxCell id="v250" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="Status list allows No-Show; the Confirmed-only transition is left to application logic." vertex="1">
          <mxGeometry height="46" width="540" x="910" y="2826" as="geometry" />
        </mxCell>
        <mxCell id="v251" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="C8" vertex="1">
          <mxGeometry height="46" width="60" x="50" y="2872" as="geometry" />
        </mxCell>
        <mxCell id="v252" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="7.15: job card has a &quot;total cost&quot;." vertex="1">
          <mxGeometry height="46" width="400" x="110" y="2872" as="geometry" />
        </mxCell>
        <mxCell id="v253" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="7.15: the parts used and their unit cost at the time are also recorded (total is derivable)." vertex="1">
          <mxGeometry height="46" width="400" x="510" y="2872" as="geometry" />
        </mxCell>
        <mxCell id="v254" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="TotalCost is stored (redundant); consistency with JOB_PART is a business rule (4-Business-Rules)." vertex="1">
          <mxGeometry height="46" width="540" x="910" y="2872" as="geometry" />
        </mxCell>
        <mxCell id="v255" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="C9" vertex="1">
          <mxGeometry height="46" width="60" x="50" y="2918" as="geometry" />
        </mxCell>
        <mxCell id="v256" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="7.7: &quot;A blacklisted customer cannot book again.&quot;" vertex="1">
          <mxGeometry height="46" width="400" x="110" y="2918" as="geometry" />
        </mxCell>
        <mxCell id="v257" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="7.12: many rentals are walk-ins with no reservation." vertex="1">
          <mxGeometry height="46" width="400" x="510" y="2918" as="geometry" />
        </mxCell>
        <mxCell id="v258" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="&quot;Book&quot; is read as both reservation and rental, so the rule is applied on both tables (Q16)." vertex="1">
          <mxGeometry height="46" width="540" x="910" y="2918" as="geometry" />
        </mxCell>
        <mxCell id="m7iBz8VQiNdsm-tKtZDD-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#000000,#CC0000);" value="&lt;b&gt;&lt;i&gt;&lt;font style=&quot;font-size: 23px;&quot;&gt;Done after negotiations with the AI&lt;/font&gt;&lt;/i&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="61" width="910" x="235" y="-74" as="geometry" />
        </mxCell>
      </root>
