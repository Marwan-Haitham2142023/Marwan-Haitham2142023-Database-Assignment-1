          <mxGeometry height="62" width="110" x="95" y="616" as="geometry" />
        </mxCell>
        <mxCell id="v50" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="Every customer is exactly one of individual / corporate, and has at least one phone number." vertex="1">
          <mxGeometry height="62" width="330" x="205" y="616" as="geometry" />
        </mxCell>
        <mxCell id="v51" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="Total participation and minimum cardinality 1 of a multivalued attribute cannot be expressed with FK / NOT NULL." vertex="1">
          <mxGeometry height="62" width="350" x="535" y="616" as="geometry" />
        </mxCell>
        <mxCell id="v52" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="Stored procedure sp_AddCustomer that inserts CUSTOMER, the subtype row and the first phone in one transaction; deferred constraint trigger as safety net." vertex="1">
          <mxGeometry height="62" width="565" x="885" y="616" as="geometry" />
        </mxCell>
        <mxCell id="v53" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="10" vertex="1">
