        <mxCell id="v55" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="Every status change of a vehicle is traced (who, when) and a car cannot be rented unless it is Available and free." vertex="1">
          <mxGeometry height="62" width="330" x="205" y="678" as="geometry" />
        </mxCell>
        <mxCell id="v56" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="A CHECK cannot write to another table nor look for overlapping rentals." vertex="1">
          <mxGeometry height="62" width="350" x="535" y="678" as="geometry" />
        </mxCell>
        <mxCell id="v57" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="Trigger AFTER UPDATE OF Status on VEHICLE inserting into VEHICLE_STATUS_LOG; sp_CheckOut verifies status and overlapping rentals and sets the status to Rented." vertex="1">
          <mxGeometry height="62" width="565" x="885" y="678" as="geometry" />
