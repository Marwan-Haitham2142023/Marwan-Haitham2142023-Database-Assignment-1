        <mxCell id="v44" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="7.12" vertex="1">
          <mxGeometry height="62" width="110" x="95" y="554" as="geometry" />
        </mxCell>
        <mxCell id="v45" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="An extension continues its original: same customer and vehicle, pickup = original expected return." vertex="1">
          <mxGeometry height="62" width="330" x="205" y="554" as="geometry" />
        </mxCell>
        <mxCell id="v46" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="Compares columns of two different rows of RENTAL." vertex="1">
          <mxGeometry height="62" width="350" x="535" y="554" as="geometry" />
        </mxCell>
        <mxCell id="v47" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="Trigger BEFORE INSERT on RENTAL when ExtendsRentalNo is not NULL, comparing with the original row. UQ(ExtendsRentalNo) already limits to one direct extension." vertex="1">
          <mxGeometry height="62" width="565" x="885" y="554" as="geometry" />
        </mxCell>
        <mxCell id="v48" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="9" vertex="1">
