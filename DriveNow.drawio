          <mxGeometry height="30" width="60" x="50" y="2264" as="geometry" />
        </mxCell>
        <mxCell id="v201" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="7.14" vertex="1">
          <mxGeometry height="30" width="110" x="110" y="2264" as="geometry" />
