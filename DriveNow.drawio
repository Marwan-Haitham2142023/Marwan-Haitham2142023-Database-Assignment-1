        </mxCell>
        <mxCell id="v5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#34495e;fontColor=#ffffff;fontStyle=1;strokeColor=#ffffff;fontSize=12;" value="Business rule" vertex="1">
          <mxGeometry height="30" width="330" x="205" y="90" as="geometry" />
        </mxCell>
        <mxCell id="v6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#34495e;fontColor=#ffffff;fontStyle=1;strokeColor=#ffffff;fontSize=12;" value="Why constraints are not enough" vertex="1">
          <mxGeometry height="30" width="350" x="535" y="90" as="geometry" />
        </mxCell>
        <mxCell id="v7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#34495e;fontColor=#ffffff;fontStyle=1;strokeColor=#ffffff;fontSize=12;" value="How to enforce it" vertex="1">
          <mxGeometry height="30" width="565" x="885" y="90" as="geometry" />
        </mxCell>
        <mxCell id="v8" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="1" vertex="1">
          <mxGeometry height="62" width="45" x="50" y="120" as="geometry" />
        </mxCell>
        <mxCell id="v9" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="7.1" vertex="1">
          <mxGeometry height="62" width="110" x="95" y="120" as="geometry" />
        </mxCell>
        <mxCell id="v10" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="A person cannot be both a rental agent and a mechanic." vertex="1">
          <mxGeometry height="62" width="330" x="205" y="120" as="geometry" />
        </mxCell>
        <mxCell id="v11" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="The two roles live in two tables; a CHECK sees one row of one table and FK / UQ cannot compare two tables." vertex="1">
          <mxGeometry height="62" width="350" x="535" y="120" as="geometry" />
        </mxCell>
        <mxCell id="v12" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="Trigger BEFORE INSERT on RENTAL_AGENT and on MECHANIC that rejects the row if the EmpID already exists in the other table (or one stored procedure sp_AssignRole that does both)." vertex="1">
          <mxGeometry height="62" width="565" x="885" y="120" as="geometry" />
        </mxCell>
        <mxCell id="v13" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="2" vertex="1">
          <mxGeometry height="62" width="45" x="50" y="182" as="geometry" />
        </mxCell>
        <mxCell id="v14" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="7.6, 8 (Fleet Mgr)" vertex="1">
          <mxGeometry height="62" width="110" x="95" y="182" as="geometry" />
        </mxCell>
        <mxCell id="v15" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="A vehicle can never be transferred to the branch it is already in, and the From branch must be where it really is." vertex="1">
          <mxGeometry height="62" width="330" x="205" y="182" as="geometry" />
        </mxCell>
        <mxCell id="v16" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="CHECK(FromBranch &lt;&gt; ToBranch) only compares the row with itself; the real location depends on the last transfer of that vehicle (or its home branch)." vertex="1">
          <mxGeometry height="62" width="350" x="535" y="182" as="geometry" />
        </mxCell>
        <mxCell id="v17" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="Trigger BEFORE INSERT on VEHICLE_TRANSFER: read the current branch (latest ToBranch, else HomeBranch), require FromBranch = current and ToBranch &lt;&gt; current." vertex="1">
          <mxGeometry height="62" width="565" x="885" y="182" as="geometry" />
        </mxCell>
        <mxCell id="v18" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="3" vertex="1">
          <mxGeometry height="78" width="45" x="50" y="244" as="geometry" />
        </mxCell>
        <mxCell id="v19" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="7.3, 7.8" vertex="1">
          <mxGeometry height="78" width="110" x="95" y="244" as="geometry" />
        </mxCell>
        <mxCell id="v20" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="Old rates are never overwritten and a category (or model / contract discount) has only one valid rate on any date: periods must not overlap." vertex="1">
          <mxGeometry height="78" width="330" x="205" y="244" as="geometry" />
        </mxCell>
        <mxCell id="v21" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="No CHECK can look at other rows; &quot;never overwrite&quot; is about UPDATE / DELETE behaviour." vertex="1">
          <mxGeometry height="78" width="350" x="535" y="244" as="geometry" />
        </mxCell>
        <mxCell id="v22" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="Trigger BEFORE UPDATE / DELETE on CATEGORY_RATE, MODEL_RATE, CONTRACT_DISCOUNT that blocks changes (except closing an open EffectiveTo once); BEFORE INSERT closes the previous open period and rejects overlap. PostgreSQL: EXCLUDE USING gist on the date range." vertex="1">
          <mxGeometry height="78" width="565" x="885" y="244" as="geometry" />
        </mxCell>
        <mxCell id="v23" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="4" vertex="1">
          <mxGeometry height="46" width="45" x="50" y="322" as="geometry" />
        </mxCell>
        <mxCell id="v24" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="7.7, 7.12" vertex="1">
          <mxGeometry height="46" width="110" x="95" y="322" as="geometry" />
        </mxCell>
        <mxCell id="v25" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="A blacklisted customer cannot make a new reservation or rental." vertex="1">
          <mxGeometry height="46" width="330" x="205" y="322" as="geometry" />
        </mxCell>
        <mxCell id="v26" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="Needs a lookup in BLACKLIST while inserting into RESERVATION / RENTAL." vertex="1">
          <mxGeometry height="46" width="350" x="535" y="322" as="geometry" />
        </mxCell>
        <mxCell id="v27" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="Trigger BEFORE INSERT on RESERVATION and RENTAL checking BLACKLIST, or the booking stored procedure sp_CreateReservation / sp_CheckOut." vertex="1">
          <mxGeometry height="46" width="565" x="885" y="322" as="geometry" />
        </mxCell>
        <mxCell id="v28" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="5" vertex="1">
          <mxGeometry height="62" width="45" x="50" y="368" as="geometry" />
        </mxCell>
        <mxCell id="v29" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="7.9" vertex="1">
          <mxGeometry height="62" width="110" x="95" y="368" as="geometry" />
        </mxCell>
        <mxCell id="v30" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="A promo code can be used at most MaxUses times and only inside its validity period." vertex="1">
          <mxGeometry height="62" width="330" x="205" y="368" as="geometry" />
        </mxCell>
        <mxCell id="v31" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="Requires COUNT(*) over RESERVATION and a comparison with PROMO_CODE; concurrent bookings can both pass." vertex="1">
          <mxGeometry height="62" width="350" x="535" y="368" as="geometry" />
        </mxCell>
        <mxCell id="v32" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="Stored procedure / trigger that locks the promo row (SERIALIZABLE or SELECT ... FOR UPDATE), counts usage, checks MadeDT between ValidFrom and ValidTo." vertex="1">
          <mxGeometry height="62" width="565" x="885" y="368" as="geometry" />
        </mxCell>
        <mxCell id="v33" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="6" vertex="1">
          <mxGeometry height="62" width="45" x="50" y="430" as="geometry" />
        </mxCell>
        <mxCell id="v34" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="7.10, 8 (Marketing)" vertex="1">
          <mxGeometry height="62" width="110" x="95" y="430" as="geometry" />
        </mxCell>
        <mxCell id="v35" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="Redeemed points can never exceed the balance, and the tier is always accurate (never typed)." vertex="1">
          <mxGeometry height="62" width="330" x="205" y="430" as="geometry" />
        </mxCell>
        <mxCell id="v36" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="Balance is a SUM over many rows; a stored Tier column could be wrong." vertex="1">
          <mxGeometry height="62" width="350" x="535" y="430" as="geometry" />
        </mxCell>
        <mxCell id="v37" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="No Tier column: VIEW computes balance and tier. Trigger BEFORE INSERT on LOYALTY_TRANSACTION rejects a Redeemed row above the balance. Earned rows are inserted only by sp_CompleteRental." vertex="1">
          <mxGeometry height="62" width="565" x="885" y="430" as="geometry" />
        </mxCell>
        <mxCell id="v38" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="7" vertex="1">
          <mxGeometry height="62" width="45" x="50" y="492" as="geometry" />
        </mxCell>
        <mxCell id="v39" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="7.12" vertex="1">
          <mxGeometry height="62" width="110" x="95" y="492" as="geometry" />
        </mxCell>
        <mxCell id="v40" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="A corporate rental must name an authorized driver; an individual rental must not." vertex="1">
          <mxGeometry height="62" width="330" x="205" y="492" as="geometry" />
        </mxCell>
        <mxCell id="v41" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="Depends on the customer TYPE stored in another table (ISA)." vertex="1">
          <mxGeometry height="62" width="350" x="535" y="492" as="geometry" />
        </mxCell>
        <mxCell id="v42" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#c9ced3;" value="Trigger on RENTAL: if CustomerNo exists in CORPORATE_CUSTOMER then DriverNo NOT NULL, else DriverNo NULL. The composite FK already forces the driver to belong to that company." vertex="1">
          <mxGeometry height="62" width="565" x="885" y="492" as="geometry" />
        </mxCell>
        <mxCell id="v43" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f4f6f8;strokeColor=#c9ced3;" value="8" vertex="1">
          <mxGeometry height="62" width="45" x="50" y="554" as="geometry" />
